# =============================================================================
# Hoku Health Care - Environment Variables Template
# Copy this file to .env and fill in real values before running.
# =============================================================================

# =============================================================================
# Database
# =============================================================================
DATABASE_URL=postgresql://hoku_user:hoku_pass@localhost:5432/hoku_health
# Hosted Postgres (e.g. Neon) needs TLS: append ?sslmode=require to the URL.
# Pool size per process (PostgreSQL only); 2 / 3 is enough for one demo instance.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# Docker image only: run init_db.py (migrations + seeding) before the server.
DB_AUTO_MIGRATE=true

# =============================================================================
# Security
# =============================================================================
# Required: 32+ random characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start outside ENVIRONMENT=test without it.
# Tokens are always signed with HS256.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=hoku-health-ai
JWT_AUDIENCE=hoku-health-api

# Demo login (POST /api/auth/demo): off unless set to true.
DEMO_LOGIN_ENABLED=false
DEMO_TOKEN_EXPIRE_MINUTES=15
DEMO_RATE_LIMIT_PER_HOUR=20

# Rate limits on POST /api/ai/chat.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=10
CHAT_IP_RATE_PER_MINUTE=20

# Client IP for the per-IP limits. false: socket peer, X-Forwarded-For ignored.
# true: the X-Forwarded-For entry TRUST_PROXY_HOPS places from the right
# (1 = the entry the proxy appended; Cloud Run: true / 1).
TRUST_PROXY=false
TRUST_PROXY_HOPS=1

# Comma-separated browser origins allowed to call the API (CORS). The demo
# page at / is same-origin and needs none.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# Prometheus scrape token for /metrics (send "Authorization: Bearer <token>").
# If empty, /metrics is served only when ENVIRONMENT is test or development.
METRICS_TOKEN=

# =============================================================================
# Groq AI (https://console.groq.com/keys)
# =============================================================================
# Leave empty to run without a model: every reply is then built from the
# matched FAQ answer and doctor data (fallback_used: true).
GROQ_API_KEY=
# If Groq stops serving a model, change these. GROQ_FAST_MODEL is used for
# intent classification and symptom extraction unless INTENT_MODEL /
# SYMPTOM_EXTRACTION_MODEL are set; GROQ_MAIN_MODEL writes the reply.
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_MAIN_MODEL=llama-3.3-70b-versatile
# INTENT_MODEL=
# SYMPTOM_EXTRACTION_MODEL=

# =============================================================================
# AI Hyperparameters
# =============================================================================
# Temperature: kept low (0.3) to reduce made-up details in medical answers.
TEMPERATURE=0.3

# Max tokens for one reply. Keeps replies short, which helps the 4 s
# request budget; it does not by itself guarantee it.
MAX_TOKENS=512

# Groq client timeout for the reply. When it is reached, the reply is built
# from the FAQ/doctor data instead (fallback_used: true).
GROQ_TIMEOUT_SECONDS=3.5

# Groq clients never retry (max_retries=0), so a timed-out call ends within
# its own client timeout instead of retrying in a background thread.

# =============================================================================
# Conversation Memory
# =============================================================================
# Maximum number of recent conversation turns loaded into context.
MEMORY_MESSAGE_LIMIT=10

# Token budget for conversation history.
MEMORY_MAX_TOKENS=307

# =============================================================================
# Intent Classification
# =============================================================================
# Timeout for intent classification. 1.0 s: shorter values made the first
# requests after start-up fall back to "general" every time.
INTENT_CLASSIFICATION_TIMEOUT=1.0

# Confidence threshold for accepting intent classification.
# Below this, the message is answered as a general question.
INTENT_CONFIDENCE_THRESHOLD=0.7

# =============================================================================
# FAQ retrieval (RAG)
# =============================================================================
# The Docker image bakes in this model and runs Hugging Face offline, so
# changing it there needs a rebuild with the new model name.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Minimum cosine similarity for an FAQ to ground a reply (see data/eval/).
RAG_SIMILARITY_THRESHOLD=0.35

# =============================================================================
# Application
# =============================================================================
ENVIRONMENT=development
# DEBUG=true also turns on SQL echo outside production, which logs query
# parameters (patient messages). Keep it false unless you need it.
DEBUG=false
LOG_FORMAT=json
LOG_LEVEL=INFO
